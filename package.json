{
  "name": "@jayjnu/pi-auto-review",
  "version": "0.5.1",
  "description": "Pi package that automatically queues a read-only code review after agent code changes.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jayjnu/pi-auto-review"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "code-review",
    "agent"
  ],
  "files": [
    "extensions/auto-review/*.ts",
    "!extensions/auto-review/*.test.ts",
    "skills/**/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./node_modules/pi-subagents/src/extension/index.ts",
      "./extensions/auto-review/index.ts"
    ],
    "skills": [
      "./skills",
      "./node_modules/pi-subagents/skills"
    ],
    "prompts": [
      "./node_modules/pi-subagents/prompts"
    ]
  },
  "dependencies": {
    "pi-subagents": "^0.25.0"
  },
  "bundledDependencies": [
    "pi-subagents"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
